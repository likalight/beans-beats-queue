# Copy to .env (or set in your host's dashboard). Everything is optional.
PORT=3000
DATA_DIR=./data

# Staff PINs. Defaults are 1111 (barista) and 9999 (booth lead): change them in production.
BARISTA_PIN=
LEAD_PIN=

# Durable storage for hosts with an ephemeral disk (Render free, Koyeb, etc.).
# Free database at https://console.upstash.com -> Redis -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_PREFIX=bb:          # change to run several booths on one database

# Optional overrides. If unset they are generated once and kept in DATA_DIR (and Redis).
# SESSION_SECRET=           # signs staff login tokens
# VAPID_PUBLIC_KEY=         # Web Push keys: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
