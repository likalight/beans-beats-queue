{
  "name": "beans-beats-queue",
  "version": "1.0.0",
  "description": "Offline-first order & pickup queue for the Beans&Beats charity coffee booth at Christmas Together 2026",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/smoke.js",
    "test:storage": "node test/storage.js",
    "test:all": "node test/smoke.js && node test/storage.js",
    "reset-day": "node scripts/reset-day.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@phosphor-icons/web": "^2.1.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.4.4",
    "web-push": "^3.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/likalight/beans-beats-queue.git"
  },
  "keywords": [
    "queue",
    "offline-first",
    "pwa",
    "web-push",
    "coffee",
    "event",
    "charity"
  ]
}
